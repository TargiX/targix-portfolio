# Public site URL — used by sitemap.ts, robots.ts, OG image absolute URLs.
SITE_URL=https://targix.dev

# Resend — required for the contact form to actually send mail.
# Without it, the public form is disabled and users are sent to the email link.
RESEND_API_KEY=
# Use a verified domain for branded sender. Falls back to Resend's shared
# onboarding@resend.dev if unset (works but reads as spammy).
CONTACT_FROM="Ilya <ilya@phosphene.cc>"
CONTACT_TO=targix8@gmail.com

# Optional: lifts the GitHub API rate limit from 60 → 5000/hr for the activity widget.
# Personal access token with no scopes needed (public data only).
GITHUB_TOKEN=

# OpenRouter — powers the Lab "AI Chat" demo (server-side proxy; the key never
# reaches the browser). Without it the chat shows an "offline" state.
# Free models exist (suffix ":free"). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model. Defaults to a free Llama 3.2 3B instruct.
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# PostHog analytics (US cloud). Project API key from Settings → Project.
# Leave empty to disable tracking entirely (pageviews, autocapture, replay).
# Enable Session Replay in the PostHog project settings to record sessions.
NEXT_PUBLIC_POSTHOG_KEY=
